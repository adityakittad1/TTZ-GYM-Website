# ══════════════════════════════════════════════════════════════════════════════
#  TTZ FITNESS — Backend Production Environment Template
#  Copy this file to .env and fill in the values.
#  NEVER commit the real .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: "https://ttzfitness.vercel.app,https://ttzfitness.com"
CORS_ORIGINS="https://YOUR-FRONTEND-DOMAIN.vercel.app,https://www.yourdomain.com"

# ── Admin credentials ─────────────────────────────────────────────────────────
ADMIN_USERNAME="your_admin_username"

# Generate a bcrypt hash with Python:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt(12)).decode())"
ADMIN_PASSWORD_HASH="$2b$12$REPLACE_WITH_YOUR_BCRYPT_HASH"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with Python:
#   python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(64)).decode())"
JWT_SECRET_KEY="REPLACE_WITH_64_BYTE_BASE64URL_SECRET"

# ── Database (future MongoDB migration) ──────────────────────────────────────
# Free MongoDB Atlas cluster URI (create one at https://cloud.mongodb.com)
MONGO_URL="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="ttz_fitness"
