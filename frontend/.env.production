# ══════════════════════════════════════════════════════════════════════════════
#  TTZ FITNESS — Frontend Production Environment
#  This file is used by `npm run build` automatically (CRA convention).
#  Replace the URL below with your actual Render.com backend URL after deploy.
# ══════════════════════════════════════════════════════════════════════════════

# Backend API URL — your Render.com FastAPI service URL (no trailing slash)
REACT_APP_BACKEND_URL=https://ttz-backend.onrender.com

# Disable source maps in production build (smaller bundle, no source exposure)
GENERATE_SOURCEMAP=false

# Disable the CRA dev-server WebSocket (not needed in production)
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
